<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="10" prefWidth="320" xmlns:fx="http://javafx.com/fxml" fx:controller="main.java.com.reclutaraspirantes.jm.controller.LoginController">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>
    <Label text="Iniciar sesión"/>
    <Label text="Usuario"/>
    <TextField fx:id="txtUsuario"/>
    <Label text="Contraseña"/>
    <PasswordField fx:id="txtContrasena"/>
    <Button text="Ingresar" onAction="#onIngresar"/>
    <Button text="Crear una cuenta" onAction="#onIrARegistro"/>
</VBox>
